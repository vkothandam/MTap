# Copy to .env and fill in. Never commit .env.

# =====================================================================
# Storage: two roots (sourcing-py storage check / init)
# =====================================================================
# Large write-once data: out/, intraday_feed/, bars_1m/, backups. Point it at the NAS
# share; `storage init` writes the .mtap-data-root marker that every job checks, so an
# unmounted share is never written to by mistake. Default: the repo root.
# MTAP_DATA_ROOT=/Volumes/mtap/mtap
# Small local state: DuckDB stores, session.json, logs, feed segments not yet uploaded.
# Keep it on the local disk, never on the NAS. Default: ./state
# MTAP_STATE_ROOT=~/mtap-state
# Mounted by scripts/storage/mount-nas.sh before the collector starts (password in the
# login Keychain: connect once in Finder with "Remember this password").
# MTAP_NAS_URL=smb://user@synology.local/mtap

# Output dir override (default: <MTAP_DATA_ROOT>/out). Leave unset normally.
# OUT_ROOT=/some/other/out

# Per-source API credentials go here, e.g.:
# EXAMPLE_API_TOKEN=

# =====================================================================
# E*TRADE scraping service  (sourcing-node serve etrade)
# See node/src/services/etrade/README.md for the full operational guide.
# Load with: node --env-file=.env node/dist/cli.js serve etrade
# =====================================================================

# --- Message bus (MTap <-> MBin) ---
BUS_TRANSPORT=redis                 # 'redis' for cross-process; 'inproc' = local only
REDIS_URL=redis://127.0.0.1:6379

# --- E*TRADE session (browser login) ---
ET_USERNAME=your-etrade-username
ET_PASSWORD=your-etrade-password

# --- OTP delivery (SMS via an email->SMS gateway) ---
# The scraper texts a link to the OTP entry page (below); a human enters the code.
SMS_EMAIL=your-gateway-account@example.com
SMS_EMAIL_PASSWORD=your-gateway-app-password
SMS_PHONE_NUMBER=5551234567
SMS_CARRIER=verizon

# --- OTP entry page (served by MTap) ---
# OTP_HOST is embedded in the SMS link, so it must be reachable from the device
# that opens it. Use your machine's LAN IP (not 127.0.0.1) if you open it on a phone.
OTP_HOST=127.0.0.1
OTP_PORT=8787

# --- Watchlist scraping ---
# The collector polls the E*TRADE watchlists only when this is true.
FEATURE_SCRAPING=true
# Intraday feeds published to Redis (mtap:evt:INTRADAY_FEED); comma list.
INTRADAY_FEEDS=etrade_watchlist

# --- Scraper runtime ---
# The schedule scripts set HEADLESS=true; set it here too for a hand-run collector.
HEADLESS=true
# PUPPETEER_EXECUTABLE_PATH=/path/to/Chromium   # reuse an already-installed browser
# SESSION_PATH=./state/etrade/session.json      # override session persistence path

# NOTE: MBin's OAuth *trading* credentials (consumer key/secret) stay in MBin and
# are NOT needed here — the scraper authenticates via browser login, not OAuth.
