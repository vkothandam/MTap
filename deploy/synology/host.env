# The NAS's settings for deploy/container (non-secret). Read by jobs.sh (bash) and passed to
# every container as an env file, so: KEY=VALUE lines only, no ${expansions}, values with
# spaces in double quotes. Secrets live in MTAP_SECRETS_FILE (chmod 600), never here.
# push.sh --trial adds host.override.env next to this file (the trial data folder, roles).

# --- host paths and the data owner (vijayan.synology = 1026:100) ---
MTAP_DATA_DIR=/volume2/Backups/MTap-Data
MTAP_STATE_DIR=/volume2/Backups/MTap-State
MTAP_SECRETS_FILE=/var/services/homes/vijayan.synology/.mtap.env
MTAP_UID=1026
MTAP_GID=100

# --- what this host runs at `start`: etrade (Redis + store + collector), massive-ws ---
# massive-ws: one connection per key, so only one host may have it.
MTAP_ROLES="etrade massive-ws"
MTAP_NOVNC_PORT=7900

# --- container settings (as the iMac's .env) ---
# The iMac's zone: log names, `date +%F` and the evening's day all match it.
TZ=America/Los_Angeles
# The texted OTP link: the NAS's LAN address.
OTP_HOST=192.168.1.100
OTP_PORT=8787
FEATURE_SCRAPING=true
INTRADAY_FEEDS=etrade_watchlist
# Paid Massive key: no REST throttle (.env.example). Keep in step with the iMac's .env.
MASSIVE_RATE_LIMIT_PER_MIN=0
